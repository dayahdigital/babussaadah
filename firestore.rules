rules_version = '2';
// Aturan keamanan Firestore — Dayah Babussa'adah (versi 3.0.0)
// Salin seluruh isi file ini ke Firebase Console → Firestore → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // ================= Fungsi bantu =================
    function userPath()  { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function setupPath() { return /databases/$(database)/documents/config/setup; }
    function me()        { return get(userPath()).data; }
    function aktif()     { return request.auth != null && exists(userPath()) && me().aktif == true; }
    function peran(list) { return aktif() && me().role in list; }
    function sa()        { return peran(['superadmin']); }
    function staf()      { return peran(['superadmin', 'admin', 'bendahara', 'operator']); }
    function keuangan()  { return peran(['superadmin', 'admin', 'bendahara']); }
    function teungku()   { return peran(['guru']); }
    function bootstrap() { return request.auth != null && !exists(setupPath()) && existsAfter(setupPath()); }
    function hanyaBerubah(kunci) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(kunci); }

    // ================= Super Admin: akses penuh (kecuali log yang tidak bisa diubah) =================
    match /{koleksi}/{id} {
      allow read: if sa();
      allow write: if sa() && koleksi != 'log';
    }

    // ================= Setup awal =================
    match /config/setup {
      allow get: if true;
      allow create: if request.auth != null && !exists(setupPath())
                    && getAfter(userPath()).data.role == 'superadmin';
    }

    // ================= Pengaturan =================
    match /config/tampilan { allow get: if true; }              // logo, foto, nama dayah
    match /config/absensi  { allow get: if true; }              // jam sesi (dipakai halaman depan)
    match /config/kas      { allow get, write: if keuangan(); } // kategori kas

    // ================= Jam server (dipakai aplikasi agar tidak bergantung jam HP) =================
    match /jam/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time;
    }

    // ================= Akun =================
    // usernames/{username} → { uid, email }. Hanya bisa dibaca satu per satu (untuk login),
    // TIDAK bisa didaftar oleh publik → nama pengguna tidak terbuka.
    match /usernames/{username} {
      allow get: if true;
      allow create: if bootstrap() && request.resource.data.uid == request.auth.uid;
    }
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if bootstrap() && request.auth.uid == uid && request.resource.data.role == 'superadmin';
    }

    // ================= Data teungku (berisi mukafaah: tidak publik) =================
    match /guru/{id} {
      allow read: if staf() || (teungku() && id == me().guruId);
      allow write: if peran(['admin']);
    }

    // ================= Jadwal mengajar (publik) =================
    function jadwalSah(id) {
      let d = request.resource.data;
      return d.sesi in ['pagi', 'malam']
        && d.hari is int && d.hari >= 0 && d.hari <= 6
        && d.kitab is string && d.kitab.size() > 0 && d.kitab.size() <= 120
        && id == d.guruId + '_' + d.sesi + '_' + string(d.hari);
    }
    match /mengajar/{id} {
      allow read: if true;
      allow write: if peran(['admin']);
      allow create, update: if teungku() && request.resource.data.guruId == me().guruId
                            && (resource == null || resource.data.guruId == me().guruId) && jadwalSah(id);
      allow delete: if teungku() && resource.data.guruId == me().guruId;
    }
    // Riwayat perubahan jadwal (publik, tidak bisa diubah kecuali Super Admin)
    match /riwayat_jadwal/{id} {
      allow read: if true;
      allow create: if aktif() && request.resource.data.waktu == request.time
                    && request.resource.data.oleh == request.auth.uid
                    && (peran(['admin']) || (teungku() && request.resource.data.guruId == me().guruId));
    }

    // ================= Pengumuman (running text & mading) =================
    match /pengumuman/{id} {
      allow read: if true;
      allow write: if peran(['admin']);
    }

    // ================= Absensi =================
    function jamKeMs(s) { let p = s.split(':'); return int(p[0]) * 3600000 + int(p[1]) * 60000; }
    function awalHariMs(tgl) {
      let p = tgl.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2])).toMillis() - 25200000;
    }
    function cfgAbsensi() {
      let p = /databases/$(database)/documents/config/absensi;
      return exists(p) ? get(p).data : {};
    }
    // Sekarang (jam server) harus di dalam jendela sesi pada tanggal itu, termasuk toleransi.
    // Sesi yang lewat tengah malam (selesai <= mulai) berakhir keesokan harinya.
    function dalamWaktuSesi(tgl, sesiId) {
      let c = cfgAbsensi();
      let j = c.get('jam', {
        'pagi':  { 'mulai': '07:30', 'selesai': '11:30' },
        'malam': { 'mulai': '20:00', 'selesai': '22:00' }
      })[sesiId];
      let awal = awalHariMs(tgl);
      let mulai = jamKeMs(j.mulai);
      let selesai = jamKeMs(j.selesai) + (jamKeMs(j.selesai) <= mulai ? 86400000 : 0);
      let now = request.time.toMillis();
      return now >= awal + mulai - c.get('toleransiSebelum', 30) * 60000
          && now <= awal + selesai + c.get('toleransiSesudah', 30) * 60000;
    }
    // Hari (0 = Ahad) cocok dengan tanggal. Patokan: Ahad 4 Jan 2026 00:00 WIB = 1767459600000 ms.
    function hariCocok(tgl, hari) {
      return hari is int && (awalHariMs(tgl) - 1767459600000) % 604800000 == hari * 86400000;
    }
    function absenMandiriSah(id) {
      let d = request.resource.data;
      let g = get(/databases/$(database)/documents/guru/$(d.guruId)).data;
      return d.guruId == me().guruId
        && g.aktif == true
        && d.status == 'H' && d.sumber == 'mandiri'
        && d.sesi in ['pagi', 'malam']
        && d.tanggal is string && d.tanggal.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.bulan == d.tanggal.split('-')[0] + '-' + d.tanggal.split('-')[1]
        && id == d.tanggal + '_' + d.sesi + '_' + d.guruId
        && hariCocok(d.tanggal, d.hari)
        && dalamWaktuSesi(d.tanggal, d.sesi)
        && exists(/databases/$(database)/documents/mengajar/$(d.guruId + '_' + d.sesi + '_' + string(d.hari)))
        && d.insentif == g.get('honorHadir', 0)
        && d.waktu == request.time
        && cfgAbsensi().get('guruMandiri', true) == true
        // selfie wajib & harus dibuat bersamaan dengan absen ini (bukan foto lama)
        && existsAfter(/databases/$(database)/documents/selfie/$(id))
        && getAfter(/databases/$(database)/documents/selfie/$(id)).data.waktu == request.time;
    }
    match /absensi/{id} {
      allow read: if staf() || peran(['pimpinan']) || (teungku() && resource.data.guruId == me().guruId);
      allow write: if peran(['admin', 'operator']);
      allow create: if teungku() && absenMandiriSah(id);
      // Izin/sakit yang disetujui Pimpinan dicatat ke absensi
      // (catatan Hadir tidak boleh ditimpa oleh persetujuan izin)
      allow create: if peran(['pimpinan']) && request.resource.data.status in ['I', 'S']
                    && request.resource.data.sumber == 'izin' && request.resource.data.insentif == 0;
      allow update: if peran(['pimpinan']) && resource.data.status != 'H' && request.resource.data.status in ['I', 'S']
                    && request.resource.data.sumber == 'izin' && request.resource.data.insentif == 0;
    }
    // Foto selfie saat absen (dipisah agar daftar absensi tetap ringan)
    match /selfie/{id} {
      allow read: if staf() || (teungku() && resource.data.guruId == me().guruId);
      allow create: if teungku() && request.resource.data.guruId == me().guruId
                    && request.resource.data.foto is string && request.resource.data.foto.size() < 200000
                    && request.resource.data.waktu == request.time
                    && id.matches('.*_' + me().guruId);
    }

    // ================= Izin & sakit (disetujui Pimpinan Dayah) =================
    match /izin/{id} {
      allow read: if peran(['pimpinan', 'admin', 'operator']) || (teungku() && resource.data.uid == request.auth.uid);
      allow create: if teungku() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.guruId == me().guruId
                    && request.resource.data.status == 'menunggu' && request.resource.data.waktu == request.time
                    && (!('lampiran' in request.resource.data) || request.resource.data.lampiran.size() < 250000);
      allow delete: if teungku() && resource.data.uid == request.auth.uid && resource.data.status == 'menunggu';
      allow update: if peran(['pimpinan']) && resource.data.status == 'menunggu'
                    && request.resource.data.status in ['disetujui', 'ditolak']
                    && hanyaBerubah(['status', 'catatanPimpinan', 'diputusOleh', 'diputusNama', 'diputusPada']);
    }

    // ================= Keuangan =================
    // Mukafaah: setelah diserahkan (dibayar) hanya Super Admin yang bisa mengubah/menghapus.
    match /gaji/{id} {
      allow read: if keuangan();
      allow get: if teungku() && resource.data.guruId == me().guruId;
      allow create: if keuangan();
      allow update, delete: if keuangan() && resource.data.get('dibayar', false) != true;
    }
    // Kas: catatan dari mukafaah hanya bisa diubah/dihapus Super Admin
    match /kas/{id} {
      allow read, create: if keuangan();
      allow update, delete: if keuangan() && resource.data.get('sumber', '') != 'penggajian';
    }
    match /bukti/{id} {
      allow read: if keuangan();
      allow create, update: if keuangan() && request.resource.data.foto is string && request.resource.data.foto.size() < 300000;
      allow delete: if keuangan();
    }
    match /ringkasan/{id} {
      allow read, write: if keuangan();
    }

    // ================= Log aktivitas (hanya bisa ditambah, tidak bisa diubah/dihapus) =================
    match /log/{id} {
      allow create: if aktif() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.waktu == request.time;
      allow update, delete: if false;
    }

    // ================= Notifikasi =================
    match /notifikasi/{id} {
      allow read: if aktif() && (resource.data.untukUid == request.auth.uid || resource.data.untukPeran == me().role);
      allow create: if aktif() && request.resource.data.waktu == request.time;
      allow update: if aktif() && (resource.data.untukUid == request.auth.uid || resource.data.untukPeran == me().role)
                    && hanyaBerubah(['dibacaOleh']);
    }
  }
}
