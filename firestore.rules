rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Fungsi bantu ----------
    function userPath()  { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function setupPath() { return /databases/$(database)/documents/config/setup; }
    function me()        { return get(userPath()).data; }
    function aktif()     { return request.auth != null && exists(userPath()) && me().aktif == true; }
    function peran(list) { return aktif() && me().role in list; }

    // Setup awal: hanya selama config/setup belum ada, dan dibuat dalam batch yang sama
    function bootstrap() {
      return request.auth != null && !exists(setupPath()) && existsAfter(setupPath());
    }

    // ---------- Setup awal ----------
    match /config/setup {
      allow get: if true;
      allow create: if request.auth != null && !exists(setupPath())
                    && getAfter(userPath()).data.role == 'superadmin';
    }

    // ---------- Akun ----------
    // usernames/{username} → { uid, email }. Bisa dibaca sebelum login (untuk proses login),
    // tetapi tidak bisa didaftar (list) kecuali oleh Super Admin.
    match /usernames/{username} {
      allow get: if true;
      allow list, write: if peran(['superadmin']);
      allow create: if bootstrap() && request.resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow get: if (request.auth != null && request.auth.uid == uid) || peran(['superadmin']);
      allow list, write: if peran(['superadmin']);
      allow create: if bootstrap() && request.auth.uid == uid
                    && request.resource.data.role == 'superadmin';
    }

    // ---------- Data aplikasi ----------
    match /guru/{id} {
      allow read: if aktif();
      allow write: if peran(['superadmin', 'admin']);
    }
    // Pengaturan absensi (daftar sesi, izin absen mandiri)
    match /config/absensi {
      allow read: if aktif();
      allow write: if peran(['superadmin', 'admin']);
    }

    // Tanggal hari ini menurut WIB (UTC+7), format YYYY-MM-DD
    function tglWIB() {
      let t = request.time + duration.value(7, 'h');
      return string(t.year()) + '-'
        + (t.month() < 10 ? '0' : '') + string(t.month()) + '-'
        + (t.day() < 10 ? '0' : '') + string(t.day());
    }

    // Absen mandiri teungku: hanya untuk dirinya, hanya HADIR, hanya hari ini,
    // insentif harus sama dengan tarifnya, dan fitur absen mandiri sedang diizinkan.
    function absenMandiriSah(id) {
      let d = request.resource.data;
      let g = get(/databases/$(database)/documents/guru/$(d.guruId)).data;
      return d.guruId == me().guruId
        && g.aktif == true
        && d.status == 'H'
        && d.sumber == 'mandiri'
        && d.tanggal == tglWIB()
        && d.bulan == d.tanggal.split('-')[0] + '-' + d.tanggal.split('-')[1]
        && id == d.tanggal + '_' + d.sesi + '_' + d.guruId
        && d.insentif == g.get('honorHadir', 0)
        && sesuaiJadwal(g, d.sesi)
        && d.waktu == request.time
        && mandiriDiizinkan();
    }

    // Hari ini menurut WIB: 0 = Ahad ... 6 = Sabtu (1 Jan 1970 adalah hari Kamis = 4)
    function hariWIB() {
      return (math.floor((request.time.toMillis() + 25200000) / 86400000) + 4) % 7;
    }

    // Jika teungku punya jadwal, sesi yang diabsen harus ada di jadwalnya untuk hari ini
    function sesuaiJadwal(g, sesi) {
      return !('jadwal' in g) || (sesi + ':' + string(hariWIB())) in g.jadwal;
    }

    function mandiriDiizinkan() {
      let p = /databases/$(database)/documents/config/absensi;
      return !exists(p) || get(p).data.get('guruMandiri', true) == true;
    }

    match /absensi/{id} {
      allow read: if peran(['superadmin', 'admin', 'operator', 'bendahara'])
                  || (peran(['guru']) && resource.data.guruId == me().guruId);
      allow write: if peran(['superadmin', 'admin', 'operator']);
      // Teungku hanya bisa MEMBUAT (bukan mengubah/menghapus) catatan hadirnya sendiri
      allow create: if peran(['guru']) && absenMandiriSah(id);
    }
    match /gaji/{id} {
      allow read, write: if peran(['superadmin', 'admin', 'bendahara']);
    }
    match /kas/{id} {
      allow read, write: if peran(['superadmin', 'admin', 'bendahara']);
    }
  }
}
