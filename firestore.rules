rules_version = '2';
// Aturan keamanan Firestore — Dayah Babussa'adah (versi 2.0.2)
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Fungsi bantu ----------
    function userPath()  { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function setupPath() { return /databases/$(database)/documents/config/setup; }
    function me()        { return get(userPath()).data; }
    function aktif()     { return request.auth != null && exists(userPath()) && me().aktif == true; }
    function peran(list) { return aktif() && me().role in list; }
    function staf()      { return peran(['superadmin', 'admin', 'bendahara', 'operator']); }

    // Setup awal: hanya selama config/setup belum ada, dan dibuat dalam batch yang sama
    function bootstrap() {
      return request.auth != null && !exists(setupPath()) && existsAfter(setupPath());
    }

    // ---------- Setup awal ----------
    match /config/setup {
      allow get: if true;
      allow create: if request.auth != null && !exists(setupPath())
                    && getAfter(userPath()).data.role == 'superadmin';
    }

    // ---------- Profil dayah (logo, foto, nama) — tampil di halaman login & publik ----------
    match /config/tampilan {
      allow get: if true;
      allow write: if peran(['superadmin']);
    }

    // ---------- Sesi Pagi & Malam (jam, hari) — tampil di halaman publik ----------
    match /config/absensi {
      allow get: if true;
      allow write: if peran(['superadmin']);
    }

    // ---------- Kategori kas ----------
    match /config/kas {
      allow get: if peran(['superadmin', 'admin', 'bendahara']);
      allow write: if peran(['superadmin', 'admin', 'bendahara']);
    }

    // ---------- Akun ----------
    // usernames/{username} → { uid, email, nama, role, aktif }.
    // Bisa dibaca sebelum login: dipakai untuk dropdown nama di halaman login.
    match /usernames/{username} {
      allow get, list: if true;
      allow write: if peran(['superadmin']);
      allow create: if bootstrap() && request.resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow get: if (request.auth != null && request.auth.uid == uid) || peran(['superadmin']);
      allow list, write: if peran(['superadmin']);
      allow create: if bootstrap() && request.auth.uid == uid
                    && request.resource.data.role == 'superadmin';
    }

    // ---------- Data guru (berisi gaji: tidak publik) ----------
    // Staf membaca semua; teungku hanya membaca datanya sendiri.
    match /guru/{id} {
      allow read: if staf() || (peran(['guru']) && id == me().guruId);
      allow write: if peran(['superadmin', 'admin']);
    }

    // ---------- Jadwal mengajar (publik) ----------
    // id = "<guruId>_<sesi>_<hari>". Teungku mengatur jadwalnya sendiri; Admin mengatur semua.
    function jadwalSah(id) {
      let d = request.resource.data;
      return d.sesi in ['pagi', 'malam']
        && d.hari is int && d.hari >= 0 && d.hari <= 6
        && d.kitab is string && d.kitab.size() > 0 && d.kitab.size() <= 120
        && id == d.guruId + '_' + d.sesi + '_' + string(d.hari);
    }
    match /mengajar/{id} {
      allow read: if true;
      allow write: if peran(['superadmin', 'admin']);
      allow create, update: if peran(['guru']) && request.resource.data.guruId == me().guruId
                            && (resource == null || resource.data.guruId == me().guruId)
                            && jadwalSah(id);
      allow delete: if peran(['guru']) && resource.data.guruId == me().guruId;
    }

    // ---------- Absensi ----------
    // Apakah tanggal "YYYY-MM-DD" adalah hari ini menurut WIB (UTC+7)?
    function hariIniWIB(tgl) {
      let p = tgl.split('-');
      let awal = timestamp.date(int(p[0]), int(p[1]), int(p[2])) - duration.value(7, 'h');
      return request.time >= awal && request.time < awal + duration.value(1, 'd');
    }

    // Apakah "hari" (0 = Ahad ... 6 = Sabtu) benar hari ini menurut WIB?
    // Hanya memakai bilangan bulat (tanpa pembagian): dihitung dari Ahad 4 Jan 2026 00:00 WIB
    // = 1767459600000 ms. Sisa bagi satu minggu (604800000 ms) menunjukkan posisi dalam minggu.
    function hariIniBenar(hari) {
      let w = (request.time.toMillis() - 1767459600000) % 604800000;
      return hari is int && hari >= 0 && hari <= 6
        && w >= hari * 86400000 && w < (hari + 1) * 86400000;
    }

    // Sesi yang diabsen harus ada di jadwal mengajar teungku untuk hari itu
    function sesuaiJadwal(guruId, sesi, hari) {
      return exists(/databases/$(database)/documents/mengajar/$(guruId + '_' + sesi + '_' + string(hari)));
    }

    function mandiriDiizinkan() {
      let p = /databases/$(database)/documents/config/absensi;
      return !exists(p) || get(p).data.get('guruMandiri', true) == true;
    }

    // Absen mandiri teungku: hanya dirinya, hanya HADIR, hanya hari ini (WIB),
    // hanya sesi di jadwalnya, insentif sama dengan tarifnya, dan fitur sedang diizinkan.
    function absenMandiriSah(id) {
      let d = request.resource.data;
      let g = get(/databases/$(database)/documents/guru/$(d.guruId)).data;
      return d.guruId == me().guruId
        && g.aktif == true
        && d.status == 'H'
        && d.sumber == 'mandiri'
        && d.tanggal is string && d.tanggal.size() == 10
        && hariIniWIB(d.tanggal)
        && d.bulan == d.tanggal.split('-')[0] + '-' + d.tanggal.split('-')[1]
        && id == d.tanggal + '_' + d.sesi + '_' + d.guruId
        && d.insentif == g.get('honorHadir', 0)
        && hariIniBenar(d.hari)
        && sesuaiJadwal(d.guruId, d.sesi, d.hari)
        && d.waktu == request.time
        && mandiriDiizinkan();
    }

    match /absensi/{id} {
      allow read: if staf() || (peran(['guru']) && resource.data.guruId == me().guruId);
      allow write: if peran(['superadmin', 'admin', 'operator']);
      // Teungku hanya bisa MEMBUAT (bukan mengubah/menghapus) catatan hadirnya sendiri
      allow create: if peran(['guru']) && absenMandiriSah(id);
    }

    // ---------- Keuangan ----------
    match /gaji/{id} {
      allow read, write: if peran(['superadmin', 'admin', 'bendahara']);
      // Teungku boleh melihat slip gajinya sendiri
      allow get: if peran(['guru']) && resource.data.guruId == me().guruId;
    }
    match /kas/{id} {
      allow read, write: if peran(['superadmin', 'admin', 'bendahara']);
    }
  }
}
