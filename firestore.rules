rules_version = '2';
// Firestore Rules Dayah Babussa'adah v4.0.0 — Multi-Unit Dayah
// Dokumen lama tanpa unitId dianggap unit-induk selama masa backfill.
service cloud.firestore {
  match /databases/{database}/documents {
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function me() { return get(userPath()).data; }
    function aktif() { return request.auth != null && exists(userPath()) && me().get('aktif', false) == true && me().get('dihapus', false) != true; }
    function peran(r) { return aktif() && me().get('role', '') == r; }
    function salahSatu(roles) { return aktif() && me().get('role', '') in roles; }
    function sa() { return peran('superadmin'); }
    function pimpinan() { return peran('pimpinan'); }
    function unit(d) { return d.get('unitId', 'unit-induk'); }
    function unitSaya(id) { return me().get('unitIds', ['unit-induk']).hasAny([id]); }
    function bacaUnit(d) { return sa() || pimpinan() || unitSaya(unit(d)); }
    function tulisUnit(d) { return sa() || (unitSaya(unit(d)) && salahSatu(['admin','bendahara','operator'])); }
    function unitBaru() { return request.resource.data.get('unitId', 'unit-induk'); }
    function unitUpdate() { return resource.data.get('unitId', 'unit-induk') == unitBaru() && unitSaya(unitBaru()); }
    function setupPath() { return /databases/$(database)/documents/config/setup; }
    function operasional(k) { return k in ['guru','mengajar','riwayat_jadwal','absensi','selfie','hadir_publik','izin','gaji','kas','bukti','ringkasan','pengumuman','notifikasi','log']; }

    match /units/{unitId} {
      allow get, list: if sa() || pimpinan() || unitSaya(unitId);
      allow create: if sa() && request.resource.data.unitId == unitId && request.resource.data.aktif == true;
      allow update: if sa() && resource.data.unitId == unitId && request.resource.data.unitId == unitId;
      allow delete: if false;
    }
    match /users/{uid} {
      allow get: if aktif() && (request.auth.uid == uid || sa());
      allow list: if sa();
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.role == 'superadmin';
      allow update: if sa() && request.resource.data.uid == uid;
      allow delete: if false;
    }
    match /usernames/{username} {
      allow get: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if sa();
    }
    match /config/setup {
      allow get: if true;
      allow create: if request.auth != null && !exists(setupPath()) && getAfter(userPath()).data.role == 'superadmin';
    }
    match /jam/{uid} { allow read, write: if request.auth != null && request.auth.uid == uid; }

    match /config/{id} {
      allow get: if id == 'tampilan' || bacaUnit(resource.data);
      allow list: if sa() || pimpinan();
      allow create: if sa() || (tulisUnit(request.resource.data) && id != 'setup');
      allow update: if sa() || (tulisUnit(request.resource.data) && unitUpdate());
      allow delete: if sa();
    }
    match /{koleksi}/{id} {
      allow read: if operasional(koleksi) && bacaUnit(resource.data);
      allow create: if operasional(koleksi) && tulisUnit(request.resource.data);
      allow update: if operasional(koleksi) && koleksi != 'log' && tulisUnit(request.resource.data) && unitUpdate();
      allow delete: if operasional(koleksi) && koleksi != 'log' && tulisUnit(resource.data) && unitUpdate();
    }
  }
}
